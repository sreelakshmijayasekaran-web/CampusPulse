{
  "expo": {
    "name": "CampusPulse",
    "slug": "CampusPulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "campuspulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.campuspulse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CampusPulse to access your photos to upload event posters."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b8febb7-523c-474c-b529-0e120c778839"
      },
      "EXPO_PUBLIC_API_KEY": "AIzaSyB-rnz8R1lFpQez3TA6NANWvlwIS0F4y38",
      "EXPO_PUBLIC_AUTH_DOMAIN": "campuspulse-20a4c.firebaseapp.com",
      "EXPO_PUBLIC_PROJECT_ID": "campuspulse-20a4c",
      "EXPO_PUBLIC_STORAGE_BUCKET": "campuspulse-20a4c.firebasestorage.app",
      "EXPO_PUBLIC_MESSAGING_SENDER_ID": "1011509951006",
      "EXPO_PUBLIC_APP_ID": "1:1011509951006:web:dbf6f7a6f2d9918ebf4c0f"
    },
    "owner": "sree_lxhme"
  }
}
